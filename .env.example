# Every environment variable the app reads, with harmless placeholder values.
# Copy to .env for local use. Real values go into Render's Environment settings, never into git.

# Required: the app stops at startup without it. Local: the Docker database from npm run db:start. Production: the Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/club
# Required: signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
# Optional: Render sets it itself; defaults to 3000.
PORT=3000

# Needed for Sign in with GitHub (step 8, not built yet). From github.com → Settings → Developer settings → OAuth Apps.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The public address of the app, used for the OAuth callback. Production: your Render URL.
PUBLIC_BASE_URL=http://localhost:3000

# Optional: the model feature falls back to an empty form without it. Free key from aistudio.google.com.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Optional: the account the MCP server signs in with; without it only the lecture tools work.
MCP_EMAIL=
MCP_PASSWORD=s