# Every environment variable your app needs, with harmless placeholder values.
# Copy to .env for local use. Real values go into your hosting provider's settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.
PORT=3000
# The local database that `npm run db:start` runs in Docker inside the codespace.
# This password only protects a throwaway local container; the hosted database gets its own.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/club
SESSION_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:3000

# Sign in with GitHub. Create an OAuth app at github.com → Settings → Developer settings →
# OAuth Apps, with your codespace's forwarded URL + /auth/github/callback as the callback URL.
# Put the id and the secret into Settings → Secrets and variables → Codespaces, not here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The model feature. A free key comes from aistudio.google.com; any provider is fine,
# and so is a model that runs locally, as long as the app still works without it.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# A session token your MCP server signs in with. It grants exactly what that user may do,
# and nothing more, because the tools go through the same services as the HTTP API.
MCP_TOKEN=
# The account the MCP server signs in with; its tools may do exactly what this user may do.
MCP_EMAIL=
MCP_PASSWORD=